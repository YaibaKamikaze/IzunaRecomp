+  const uint32_t exponent = (b >> 23) & 0xFF, mantissa = b & 0x7FFFFF;
+  if (exponent == 0) return (b & 0x80000000u) ? 0xFF800000u : 0x7F800000u;        // +-0 (and denormals): +-inf
