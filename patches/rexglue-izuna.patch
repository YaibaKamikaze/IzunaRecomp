+// [IzunaRecomp] The controllers' state kept fresh by a thread of its own.
+// GetDeviceState only asks the UI thread to pump SDL and reads the result of
+// the last pump - a frame old, more while the UI thread sat in the presenter's
+// pacing and present (~11 ms a paint on NVIDIA). test24 polled on the game's
+// own thread at each read instead: fresh, but the game's thread then waited on
+// SDL's joystick lock (held by the UI thread's pump) and on the backends'
+// polls, and its frames ran late (in a stretch of 600 flips, 152 found the
+// game late; test23: at most 6). Here SDL_UpdateGamepads (safe on any thread)
+// runs every sdl_poll_ms on this thread, the events it posts reach
+// HandleEvent's buffer, and the game's read applies them: at most that old.
+void SDLInputDriver::StartPollThread() {
+  if (poll_thread_.joinable() || REXCVAR_GET(sdl_poll_ms) <= 0) return;
+  poll_stop_.store(false, std::memory_order_release);
+  poll_thread_ = std::thread([this] {
+    while (!poll_stop_.load(std::memory_order_acquire)) {
+      SDL_UpdateGamepads();
+      std::this_thread::sleep_for(std::chrono::milliseconds(std::max(1, REXCVAR_GET(sdl_poll_ms))));
