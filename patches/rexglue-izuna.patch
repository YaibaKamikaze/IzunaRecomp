+// [ng2 ps5 port] Frame reports (see frame_report_now).
+namespace {
+// Frame report state (GPU thread only).
+struct FrameReport {
+  int frames_left = 0;     // > 0 while capturing
+  int report_index = 0;
+  uint32_t frame = 0;      // within the report
+  uint32_t resolves = 0;
+  std::string folder;
+  std::chrono::steady_clock::time_point first_swap{};
+  bool timed_done = false;
+  std::ofstream sequence;  // draws.txt: every draw and resolve, in order
+  uint32_t draws = 0;
+};
+FrameReport g_report;
+
+// At each swap: start a report when asked for, and count its frames down.
+void FrameReportSwap() {
+  const auto now = std::chrono::steady_clock::now();
+  if (g_report.first_swap == std::chrono::steady_clock::time_point{}) {
+    g_report.first_swap = now;
+  }
+  if (g_report.frames_left > 0) {
+    ++g_report.frame;
+    if (--g_report.frames_left == 0) {
+      g_report.sequence.close();
+      REXGPU_INFO("[frame report] {} written ({} resolves, {} draws)", g_report.folder, g_report.resolves,
+                  g_report.draws);
+    }
+    return;
+  }
+  bool start = false;
+  if (REXCVAR_GET(frame_report_now)) {
+    rex::cvar::SetFlagByName("frame_report_now", "false");
+    start = true;
+  }
+  const int after = REXCVAR_GET(frame_report_after_seconds);
+  if (!g_report.timed_done && after > 0 && now - g_report.first_swap >= std::chrono::seconds(after)) {
+    g_report.timed_done = true;
+    start = true;
+  }
+  if (!start) {
+    return;
+  }
+  ++g_report.report_index;
+  // Absolute, beside the executable (/app0 on the PS5) unless set: the
+  // working directory is not reliably the app's folder.
+  std::string root = REXCVAR_GET(frame_report_path);
+  if (root.empty()) {
+    root = (rex::filesystem::GetExecutableFolder() / "logs" / "frame_reports").string();
+  }
+  g_report.folder = fmt::format("{}/{:03}", root, g_report.report_index);
+  std::error_code ec;
+  std::filesystem::create_directories(g_report.folder, ec);
+  if (ec) {
+    REXGPU_ERROR("[frame report] cannot create {}: {}", g_report.folder, ec.message());
+  }
+  g_report.frames_left = std::max(1, REXCVAR_GET(frame_report_frames));
+  g_report.frame = 0;
+  g_report.resolves = 0;
+  g_report.draws = 0;
+  g_report.sequence.close();
+  g_report.sequence.open(g_report.folder + "/draws.txt", std::ios::trunc);
+  REXGPU_INFO("[frame report] capturing {} frame(s) into {}", g_report.frames_left, g_report.folder);
+}
+
+// One draw of a frame report: its render target and every texture its shaders
+// fetch, so a pass that samples a resolved image can be matched to the resolve.
+void FrameReportDraw(const RegisterFile& regs, const VulkanShader* vertex_shader,
+                     const VulkanShader* pixel_shader) {
+  if (g_report.frames_left <= 0 || !g_report.sequence.is_open() || g_report.draws >= 6000) {
+    return;
+  }
