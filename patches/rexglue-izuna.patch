+  const uint32_t coefficient = kCoefficients[(((input >> 23) & 1) << 4) | (mantissa >> 19)];
+  uint32_t estimate = ((coefficient << 10) & 0x3FFFC00) - (((mantissa >> 9) & 1023) * (coefficient >> 16));
