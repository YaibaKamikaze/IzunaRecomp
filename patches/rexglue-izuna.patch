+uint64_t VulkanCommandProcessor::AsyncSubmittedThrough() const {
+  // Nothing queued since the worker's last submit: everything is submitted.
+  const uint64_t through = async_submitted_through_.load(std::memory_order_acquire);
+  std::lock_guard lock(async_submit_mutex_);
+  return (async_submit_jobs_.empty() && !async_submit_busy_) ? UINT64_MAX : through;
+}
+
+void VulkanCommandProcessor::DrainAsyncSubmit() {
+  if (!async_submit_thread_.joinable()) {
+    return;
+  }
+  std::unique_lock lock(async_submit_mutex_);
+  async_submit_idle_cv_.wait(lock, [this] { return async_submit_jobs_.empty() && !async_submit_busy_; });
+}
+
+void VulkanCommandProcessor::StopAsyncSubmit() {
+  if (!async_submit_thread_.joinable()) {
+    return;
+  }
+  {
+    std::lock_guard lock(async_submit_mutex_);
+    async_submit_stop_ = true;
+  }
+  async_submit_cv_.notify_one();
+  async_submit_thread_.join();
+  async_submit_free_streams_.clear();
+}
+
+void VulkanCommandProcessor::AsyncSubmitWorkerMain() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  for (;;) {
+    AsyncSubmitJob job;
+    {
+      std::unique_lock lock(async_submit_mutex_);
+      async_submit_cv_.wait(lock, [this] { return async_submit_stop_ || !async_submit_jobs_.empty(); });
+      if (async_submit_jobs_.empty()) {
+        return;  // stop requested, nothing left
+      }
+      job = std::move(async_submit_jobs_.front());
+      async_submit_jobs_.pop_front();
+      async_submit_busy_ = true;
+    }
+    VkResult result = VK_SUCCESS;
+    VkCommandBufferBeginInfo begin_info = {};
+    begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+    begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    result = dfn.vkBeginCommandBuffer(job.command_buffer.buffer, &begin_info);
+    if (result == VK_SUCCESS) {
+      job.stream->Execute(job.command_buffer.buffer);
+      result = dfn.vkEndCommandBuffer(job.command_buffer.buffer);
+    }
+    if (result == VK_SUCCESS) {
+      VkSubmitInfo submit_info = {};
+      submit_info.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+      submit_info.waitSemaphoreCount = uint32_t(job.wait_semaphores.size());
+      submit_info.pWaitSemaphores = job.wait_semaphores.empty() ? nullptr : job.wait_semaphores.data();
+      submit_info.pWaitDstStageMask = job.wait_stage_masks.empty() ? nullptr : job.wait_stage_masks.data();
+      submit_info.commandBufferCount = 1;
+      submit_info.pCommandBuffers = &job.command_buffer.buffer;
+      ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+          vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+      result = dfn.vkQueueSubmit(queue_acquisition.queue(), 1, &submit_info, job.fence);
+    }
+    if (result != VK_SUCCESS) {
+      async_submit_error_.store(int(result));
+    }
+    job.stream->Reset();
+    {
+      std::lock_guard lock(async_submit_mutex_);
+      async_submitted_through_.store(job.submission, std::memory_order_release);
+      async_submit_free_streams_.push_back(std::move(job.stream));
+      async_submit_busy_ = false;
+    }
+    async_submit_idle_cv_.notify_all();
+  }
+}
