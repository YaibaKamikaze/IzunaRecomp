<?xml version="1.0" encoding="utf-8"?>
<!-- [IzunaRecomp] The Android app (tools/android/make_apk.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.izunaproject.izunarecomp"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION@">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34" />

    <!-- The player's own copy of the game, wherever it is on the device's storage. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The Kasumi Renderer draws with Vulkan 1.1. -->
    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <application
        android:label="IzunaRecomp"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:appCategory="game"
        android:isGame="true"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name=".IzunaActivity"
            android:label="IzunaRecomp"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="SDL_MAIN_ENTRY_FUNCTION" android:value="SDL_main" />
        </activity>

        <activity
            android:name=".IzunaRestartActivity"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
